<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041: libera as APIs do Windows usadas para ler o histórico de uso de dados -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ManutencaoImpressora</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>2.1.2</Version>
    <ApplicationIcon>icone.ico</ApplicationIcon>
    <!-- WFO1000 (.NET 9+): avisa sobre propriedades públicas de controles sem configuração para o
         designer do Visual Studio. Os controles daqui são montados em código, não no designer. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- Programa que fica o dia todo aberto: coletor de memória sem a thread extra de segundo plano -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prefere memória menor a um pouco mais de velocidade (0 = padrão, 9 = máximo de economia) -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- O ícone também vai como recurso, para as janelas e a bandeja não pegarem a versão antiga do cache do Windows -->
    <EmbeddedResource Include="icone.ico" LogicalName="icone.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <PackageReference Include="System.Management" Version="10.0.*" />
    <!-- Uso da placa de vídeo de qualquer marca (contadores "GPU Engine" do Windows) -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.*" />
    <!-- Uso de internet por app: eventos de rede do kernel (ETW) e o serviço do Windows -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.*" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.*" />
  </ItemGroup>

</Project>
